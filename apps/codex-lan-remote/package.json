{
  "name": "@zcode/codex-lan-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsup src/adapters/entry.ts --format esm --platform node --target node24 --out-dir dist/server --clean",
    "build:web": "vite build",
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/adapters/entry.ts",
    "dev:web": "vite",
    "start": "node dist/server/entry.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "oxlint src test"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.11",
    "hono": "^4.12.9",
    "lucide-react": "^1.17.0",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.2"
  }
}
