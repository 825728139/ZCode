NODE_ENV=development
CODEX_REMOTE_HOST=0.0.0.0
CODEX_REMOTE_PORT=3040
DATABASE_URL=postgres://codex_remote:change-me@127.0.0.1:5432/codex_remote
SESSION_PEPPER=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password
ALLOW_SIGNUP=0
SECURE_COOKIES=0
RUNTIME_DRIVER=local
CODEX_COMMAND=codex
WORKSPACE_ROOT=./data/workspaces
RUNTIME_HOME_ROOT=./data/runtime-homes
WEB_ROOT=./dist/web
